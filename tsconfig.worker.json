{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@worker/*": ["./worker/*"]
    }
  },
  "include": ["shared", "worker", ".cloudflare/types/index.d.ts"]
}
